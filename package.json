{
  "private": true,
  "workspaces": [
    "packages/sdk",
    "packages/web"
  ],
  "scripts": {
    "build:sdk": "bun run --cwd packages/sdk build",
    "publish:sdk": "bun run build:sdk && npm publish -w packages/sdk",
    "build:web": "bun run --cwd packages/web build",
    "dev:web": "bun run --cwd packages/web dev",
    "contract:build": "cd packages/contracts && sforge build",
    "contract:test": "cd packages/contracts && sforge test -vv"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
